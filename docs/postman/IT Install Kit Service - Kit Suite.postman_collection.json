      "item": [
        {
          "name": "Initiate a kit",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('iktOrganisationId')) { pm.collectionVariables.set('iktOrganisationId', pm.variables.replaceIn('{{$guid}}')); }",
                  "pm.collectionVariables.set('iktKitName', 'Windows 11 EN BASE ' + Date.now());",
                  "pm.request.body.raw = pm.request.body.raw.replace('Windows 11 EN BASE', pm.collectionVariables.get('iktKitName'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const kit = pm.response.json();",
                  "pm.collectionVariables.set('iktKitId', kit.id);",
                  "pm.test('A new kit is ACTIVE at revision 1', () => { pm.expect(kit.status).to.eql('ACTIVE'); pm.expect(kit.revision).to.eql(1); });",
                  "pm.test('It names its system, language and machine class', () => { pm.expect(kit.systemId).to.eql('W11'); pm.expect(kit.language).to.eql('EN'); pm.expect(kit.machineClass).to.eql('BASE'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{iktOrganisationId}}"
              },
              {
                "key": "X-Executor",
                "value": "{{executor}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/it-install-kit/v1/initiate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "it-install-kit",
                "v1",
                "initiate"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Windows 11 EN BASE\",\n  \"family\": \"WINDOWS\",\n  \"role\": \"WORKSTATION\",\n  \"language\": \"EN\",\n  \"systemId\": \"W11\",\n  \"machineClass\": \"BASE\"\n}",
